confirm-close-surface = false
# Font configuration
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 16

# Window settings
window-padding-x = 5
window-padding-y = 5
window-height = 24
window-width = 80 
# window-decoration = false
background-opacity = 0.85

# Cursor
adjust-cursor-thickness = 2
cursor-style = bar
cursor-style-blink = true
# Terminal settings
term = xterm-256color

# Keybindings
keybind = f11=toggle_fullscreen

# Themes
theme = TokyoNight
